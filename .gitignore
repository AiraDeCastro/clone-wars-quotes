# macOS / Windows
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local

# iOS / Xcode
# ios/*.xcodeproj is generated by XcodeGen from ios/project.yml — not checked in.
ios/*.xcodeproj/
ios/**/xcuserdata/
ios/ColdOpenCore/.build/
ios/ColdOpenCore/Package.resolved
*.xcworkspace/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Android
# (gradlew / gradlew.bat / gradle/wrapper/gradle-wrapper.jar aren't generated
# yet — see android/README.md. Once `gradle wrapper` is run, those three
# files should be committed, not ignored.)
*.iml
.gradle/
local.properties
.idea/
build/
captures/
*.apk
*.aab

# Windows / general build output
bin/
obj/
out/
dist/

# .NET / Windows widget provider (bin/, obj/ above already cover per-project
# build output; these are MSIX-packaging-specific)
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.msix
*.msixbundle
*.appxsym
*.appxupload

# Corpus build artifact (regenerated by `npm run build`)
corpus/quotes.sqlite

# Editor
.vscode/
*.swp
